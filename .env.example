# ============================================================
#  قالب متغيرات البيئة (بدون قيم حقيقية — آمن للرفع على GitHub)
#  انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# ============================================================

# --- Supabase (قاعدة البيانات + المصادقة + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-secret

# --- معلومات التواصل (قابلة للتغيير لاحقاً من لوحة التحكم) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
PHONE=+97400000000
WHATSAPP_NUMBER=97400000000
SITE_EMAIL=info@test-web.com
COMMERCIAL_REGISTRATION=CR-00000

# --- عنوان الخريطة ---
NEXT_PUBLIC_MAP_EMBED_URL=https://maps.google.com/?q=Qatar

# --- كلمة مرور لوحة الإدارة الافتراضية (غيّرها فوراً من لوحة التحكم) ---
ADMIN_DEFAULT_PASSWORD=change-me-immediately

# --- الدفع (placeholder — يُفعّل لاحقاً عند توفر المزود) ---
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=stub
# PAYMENT_API_KEY=your-payment-api-key
